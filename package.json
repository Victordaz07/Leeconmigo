{
  "name": "lee-conmigo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lee Conmigo — tutor de lectura en voz alta bilingüe (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lee-conmigo/reader",
    "build": "npm run build -w @lee-conmigo/reader",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:extract": "node scripts/extract-design-assets.mjs",
    "visual:reference": "node scripts/visual/capture-reference.mjs",
    "visual:app": "node scripts/visual/capture-app.mjs",
    "stories:check": "vitest run packages/story-engine/tests/stories-content.test.ts",
    "tablet": "npm run build:tablet -w @lee-conmigo/reader && npm run preview -w @lee-conmigo/reader -- --host --port 4173 --strictPort",
    "tunnel": "ssh -p 443 -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -T -R0:localhost:4173 a.pinggy.io",
    "templates:guides": "node scripts/make-template-guides.mjs",
    "prompts:html": "node scripts/make-prompts-html.mjs",
    "stories:budget": "node scripts/story-budget.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "jsdom": "^30.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
