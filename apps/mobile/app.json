{
  "expo": {
    "name": "Kitewise",
    "slug": "kitewise",
    "version": "0.1.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitewise.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kitewise escucha mientras el niño lee en voz alta para seguir la lectura. La voz se procesa en el dispositivo y nunca se graba ni se envía."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6FE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kitewise.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidPermissions": [],
          "androidForegroundService": false,
          "disableFFmpeg": true
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#1E6FE8"
        }
      ],
      "./plugins/no-push.js",
      "expo-speech-recognition",
      "./plugins/local-speech.js"
    ]
  }
}
