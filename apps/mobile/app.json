{
  "expo": {
    "name": "Kitewise",
    "slug": "kitewise",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitewise.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kitewise escucha mientras el niño lee en voz alta para seguir la lectura. La voz se procesa en el dispositivo y nunca se graba ni se envía."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F8FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kitewise.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-navigation-bar",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidPermissions": [],
          "androidForegroundService": false,
          "disableFFmpeg": true
        }
      ]
    ]
  }
}
